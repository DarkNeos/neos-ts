{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neos-ts-beta",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "neos-beta.example.com",
      "custom_domain": true
    }
  ]
}
